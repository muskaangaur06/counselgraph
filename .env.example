# Copy this file to .env and fill in real values. Never commit .env.

# LLM provider (Gemini), get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Neo4j graph database, free instance at https://console.neo4j.io
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USER=your-neo4j-username
NEO4J_PASSWORD=your-neo4j-password

# Optional: shared secret used only as a fallback signing key if SESSION_SECRET
# isn't set. Not required for normal use once the reviewer roster below is set.
API_KEY=your-generated-api-key-here

# Fixed reviewer roster (no user database, no signup). Either set REVIEWERS as a
# JSON array, or use the numbered REVIEWER_N_* vars below; if neither is set,
# ADMIN_USERNAME/ADMIN_PASSWORD (role "admin") is used as the sole account.
# REVIEWERS=[{"username":"admin","password":"change-this","role":"admin"},{"username":"reviewer1","password":"change-this","role":"reviewer"},{"username":"counsel1","password":"change-this","role":"senior_counsel"}]
REVIEWER_1_USERNAME=admin
REVIEWER_1_PASSWORD=change-this-password
REVIEWER_1_ROLE=admin
REVIEWER_2_USERNAME=reviewer1
REVIEWER_2_PASSWORD=change-this-password
REVIEWER_2_ROLE=reviewer
REVIEWER_3_USERNAME=counsel1
REVIEWER_3_PASSWORD=change-this-password
REVIEWER_3_ROLE=senior_counsel

# Backward-compatible single-account fallback, used only if neither REVIEWERS nor
# any REVIEWER_N_* var above is set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Secret used to sign session cookies. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=your-generated-session-secret-here

# Postgres operational data store (org profiles, documents, clauses, risk flags,
# playbooks, review actions, audit log, summary history, knowledge library).
# Leave unset to fall back to a local SQLite file at data/legal_graphrag.db.
DATABASE_URL=postgresql+psycopg2://counsel_graph:change-this-password@localhost:5432/counsel_graph
POSTGRES_USER=counsel_graph
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=counsel_graph

# MinIO object storage (S3-compatible, self-hosted) for uploaded documents.
# Leave STORAGE_ENDPOINT unset to fall back to local-disk storage at data/uploads.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=counsel_graph
STORAGE_SECRET_KEY=change-this-password
STORAGE_BUCKET=legal-documents

# Optional: comma-separated origins allowed to call this API cross-origin
# (leave unset if serving the bundled UI from the same origin)
CORS_ALLOWED_ORIGINS=

# Optional: guardrail overrides (defaults shown)
MAX_PDF_SIZE_MB=50
MAX_PAGES_PER_INGESTION=300
MAX_QUESTION_LENGTH=2000
MAX_COMMENT_LENGTH=4000
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: persistent LangGraph checkpointer instead of the default in-memory one
# CHECKPOINTER_BACKEND=postgres
# CHECKPOINTER_POSTGRES_URL=postgresql://user:password@host:5432/dbname
# CHECKPOINTER_BACKEND=redis
# CHECKPOINTER_REDIS_URL=redis://host:6379/0
